{
  "name": "amstr-cvm",
  "version": "1.0.0",
  "description": "AMSTR Phala CVM Service (Shade Agent pattern) in TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e 'try { require(\"fs\").copyFileSync(\"src/settledSeeds.json\", \"dist/settledSeeds.json\"); } catch(e){}'",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsc && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/hashes": "^1.4.0",
    "@phala/dcap-qvl": "^0.7.0",
    "@phala/dstack-sdk": "^0.5.8",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "near-api-js": "^4.0.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
